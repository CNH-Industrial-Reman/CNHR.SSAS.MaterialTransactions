                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="Backflush" msprop:design-time-name="500ac20e-6ca4-4801-9263-a7058467c385" msprop:DbColumnName="Backflush" msprop:FriendlyName="Backflush" type="xs:unsignedByte" minOccurs="0" />
                  <xs:element name="CreateDate" msprop:design-time-name="cd3a8c81-72d7-4792-a0af-f8e777876ff0" msprop:DbColumnName="CreateDate" msprop:FriendlyName="CreateDate" type="xs:dateTime" minOccurs="0" />
                  <xs:element name="PrimaryKey" msprop:design-time-name="376c5730-2252-4bed-a1f9-08da653784b4" msprop:DbColumnName="PrimaryKey" msprop:FriendlyName="PrimaryKey" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="40" />
                      </xs:restriction>
