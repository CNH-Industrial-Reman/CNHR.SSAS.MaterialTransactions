              <xs:complexType>
                <xs:sequence>
                  <xs:element name="TransactionType" msprop:design-time-name="1b2c3d4e-5f6a-4b7c-8d9e-0f1a2b3c4d5e" msprop:DbColumnName="TransactionType" msprop:FriendlyName="TransactionType">
