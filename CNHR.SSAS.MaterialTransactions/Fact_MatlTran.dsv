                  </xs:element>
                  <xs:element name="SourceSystem" msprop:design-time-name="b24f83ce-09f3-4502-b88f-91eaadfecde2" msprop:DbColumnName="SourceSystem" msprop:FriendlyName="SourceSystem" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="50" />
                      </xs:restriction>
