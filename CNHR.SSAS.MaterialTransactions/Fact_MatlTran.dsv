            <xs:element name="DimJobMaterial" msprop:design-time-name="f6a7b8c9-0d1e-4f2a-3b4c-5d6e7a8b9c0d" msprop:IsLogical="True" msprop:FriendlyName="DimJobMaterial" msprop:DbTableName="DimJobMaterial" msprop:TableType="View" msprop:Description="" msprop:QueryDefinition="SELECT DISTINCT&#xD;&#xA;       COALESCE (NULLIF (LTRIM(RTRIM(Job)), ''), 'NA') AS Job,&#xD;&#xA;       COALESCE (Suffix, -1) AS Suffix,&#xD;&#xA;       COALESCE (OperNum, -1) AS OperNum,&#xD;&#xA;       COALESCE (Sequence, -1) AS Sequence,&#xD;&#xA;       Units, PlannedQty, SL_QtyIssued, ActualQtyFromTran,&#xD;&#xA;       COALESCE (NULLIF (LTRIM(RTRIM(Job)), ''), 'NA') + '-' + CAST(COALESCE(Suffix, -1) AS VARCHAR(6)) + '-' + CAST(COALESCE(OperNum, -1) AS VARCHAR(11)) + '-' + CAST(COALESCE(Sequence, -1) AS VARCHAR(6)) AS JobMaterialName&#xD;&#xA;FROM   Fact_MatlTran" msprop:QueryBuilder="SpecificQueryBuilder">
