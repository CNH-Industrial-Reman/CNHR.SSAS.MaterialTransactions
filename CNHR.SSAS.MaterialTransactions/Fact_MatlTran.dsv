  <DataSourceID>CNH Reman Warehouse CSI</DataSourceID>
  <Schema>
    <xs:schema id="Fact_MatlTran" xmlns="" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" xmlns:msprop="urn:schemas-microsoft-com:xml-msprop">
      <xs:element name="Fact_MatlTran" msdata:IsDataSet="true" msdata:UseCurrentLocale="true" msprop:design-time-name="0233c224-56c5-42da-b8ed-d6bc986ddfdf">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="Fact_MatlTran" msprop:design-time-name="fb393182-062f-4264-a56f-957495de58dc" msprop:IsLogical="True" msprop:FriendlyName="Fact_MatlTran" msprop:DbTableName="Fact_MatlTran" msprop:TableType="View" msprop:Description="" msprop:QueryDefinition="SELECT DateKey, Site_Key, SiteItemKey, TransactionType, TransactionNumber, Quantity,&#xD;&#xA;             COALESCE (NULLIF (LTRIM(RTRIM(Warehouse)), ''), 'NA') AS Warehouse,&#xD;&#xA;             COALESCE (NULLIF (LTRIM(RTRIM(Location)), ''), 'NA') AS Location,&#xD;&#xA;             WorkCenter, ReferenceType,&#xD;&#xA;             COALESCE (NULLIF (LTRIM(RTRIM(ReferenceNumber)), ''), 'NA') AS ReferenceNumber,&#xD;&#xA;             COALESCE (LineSuffix, -1) AS LineSuffix,&#xD;&#xA;             Release, UserCode, ReasonCode, Backflush, CreateDate, PrimaryKey, SourceSystem, &#xD;&#xA;             COALESCE (NULLIF (LTRIM(RTRIM(Item)), ''), 'NA') AS Item,&#xD;&#xA;             ItemDescription, TransactionTypeDescription, Job, Suffix, OperNum, Sequence, Units,&#xD;&#xA;             PlannedQty, SL_QtyIssued, ActualQtyFromTran&#xD;&#xA;FROM   Fact_MatlTran&#xD;&#xA;WHERE  DateKey IN (SELECT DateKey FROM Dim_Date WHERE (CalendarYear &gt;= YEAR(GETDATE()) - 7) AND ([Date] &lt; GETDATE()))&#xD;&#xA;       AND NOT (TransactionType = 'N' AND ReferenceType = 'J')" msprop:QueryBuilder="SpecificQueryBuilder">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="Site_Key" msprop:design-time-name="80790076-748e-4022-8440-f7507ac75120" msprop:DbColumnName="Site_Key" msprop:FriendlyName="Site_Key" type="xs:int" minOccurs="0" />
                  <xs:element name="SiteItemKey" msprop:design-time-name="66a9d324-0210-413d-ac39-f53f579abf9a" msprop:DbColumnName="SiteItemKey" msprop:FriendlyName="SiteItemKey" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="39" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="TransactionType" msprop:design-time-name="21301d9e-067c-4b0c-820c-40418acb3330" msprop:DbColumnName="TransactionType" msprop:FriendlyName="TransactionType" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="1" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="TransactionNumber" msprop:design-time-name="4d2006d6-c079-4f21-a805-6869b0aa2964" msprop:DbColumnName="TransactionNumber" msprop:FriendlyName="TransactionNumber" type="xs:long" minOccurs="0" />
                  <xs:element name="Quantity" msprop:design-time-name="43aeb087-4fd0-42b8-8b04-5a089d9942a9" msprop:DbColumnName="Quantity" msprop:FriendlyName="Quantity" type="xs:decimal" minOccurs="0" />
                  <xs:element name="Warehouse" msprop:design-time-name="e9490ebf-9624-4f29-a3e8-8c5de3e6a8bd" msprop:DbColumnName="Warehouse" msprop:FriendlyName="Warehouse" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="4" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="Location" msprop:design-time-name="d53e7db4-a802-48ad-afb9-86c9a8ec4260" msprop:DbColumnName="Location" msprop:FriendlyName="Location" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="15" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="WorkCenter" msprop:design-time-name="2149fedd-f402-4383-a8d7-3bd0dd2bfb24" msprop:DbColumnName="WorkCenter" msprop:FriendlyName="WorkCenter" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="6" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="ReferenceType" msprop:design-time-name="8e646b46-1ca4-41a4-85da-f5dfbc11ab55" msprop:DbColumnName="ReferenceType" msprop:FriendlyName="ReferenceType" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="1" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="ReferenceNumber" msprop:design-time-name="3f4d667c-95dd-4887-a2bf-6f55c084db40" msprop:DbColumnName="ReferenceNumber" msprop:FriendlyName="ReferenceNumber" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="20" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="LineSuffix" msprop:design-time-name="f96d467e-7894-4ba6-a9f5-948b276af111" msprop:DbColumnName="LineSuffix" msprop:FriendlyName="LineSuffix" type="xs:short" minOccurs="0" />
                  <xs:element name="Release" msprop:design-time-name="326de8ef-5013-4856-93b3-95d46b324d05" msprop:DbColumnName="Release" msprop:FriendlyName="Release" type="xs:short" minOccurs="0" />
                  <xs:element name="UserCode" msprop:design-time-name="b3cf3117-ec4c-4bcc-9479-2f72b7f68691" msprop:DbColumnName="UserCode" msprop:FriendlyName="UserCode" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="3" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="ReasonCode" msprop:design-time-name="45363572-ac5e-4ea1-85be-0730b1c7eb94" msprop:DbColumnName="ReasonCode" msprop:FriendlyName="ReasonCode" minOccurs="0">
                    <xs:simpleType>
